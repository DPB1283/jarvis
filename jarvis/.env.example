# Optional. The easiest way is the "API keys" tab in Jarvis Settings. Keys found here are imported on first start.
# Copy this file to .env (never commit .env).
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Optional: Xweather (weather alerts + air quality).
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
# Wake word is offline Vosk - no key needed. Model goes in models/vosk-model-small-en-us-0.15.
